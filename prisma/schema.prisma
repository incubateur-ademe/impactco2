// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "./generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id    String @id @default(cuid())
  key   String @unique @db.Uuid
  owner String

  @@map("api_keys")
}

model GMapsCache {
  id    String   @id
  car   Float
  foot  Float
  rail  Float
  plane Float
  date  DateTime

  @@map("gmaps_cache")
}

model Faq {
  id        String   @id
  title     String
  pages     String[]
  categorie String
  ancre     String?
  outils    String[]
  content   String
  language  String
  createdAt DateTime

  @@map("faqs")
}
