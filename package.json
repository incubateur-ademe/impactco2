  "scripts": {
    "build:ecvs": "pnpm build:empreinte & pnpm build:agribalyse",
    "build:empreinte": "tsx src/scripts/buildFromEmpreinte.ts",
    "build:agribalyse": "tsx src/scripts/buildFromAgribalyse.ts",
    "build:boisson": "tsx src/scripts/buildFromAgribalyse.ts boissons",
    "test": "pnpm testu && pnpm testa && pnpm teste",
    "testa": "NODE_ENV=test jest ./testa",
    "teste": "NODE_ENV=test playwright test --reporter=list",
    "testu": "NODE_ENV=test jest ./testu",
    "jest:local": "NODE_ENV=test jest --watch",
    "testa:local": "NODE_ENV=test jest --watch ./testa",
    "teste:local": "NODE_ENV=test playwright test --ui",
    "testu:local": "NODE_ENV=test jest --watch ./testu",
    "dev": "next dev",
    "prebuild": "pnpm prisma:generate",
    "prisma:generate": "prisma generate",
    "build": "pnpm webpack && next build",
    "build:analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap",
    "webpack": "dotenv run -f .env -- webpack",
    "import:faqs": "tsx src/scripts/importFAQs.ts",
    "stats:biz": "tsx src/scripts/getBizStats.ts",
    "stats": "tsx src/scripts/getStats.ts",
    "stats:yearly": "tsx src/scripts/getYearlyStats.ts",
    "start": "next start",
    "lint": "eslint .",
    "chromatic": "chromatic --exit-zero-on-changes",
    "testIframes": "playwright install chromium; tsx src/scripts/testIframes.ts",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
